{
  "name": "dsh-permission-plan",
  "version": "0.2.2",
  "description": "One approval dialog for everything a task will need, then keyword memory instead of per-command prompts. Splits the batch pre-approval out of dsh-mod-build-auto-approve and merges it with generic keyword learning.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client-0.2.1.js"
  },
  "files": [
    "index.mjs",
    "client-0.2.1.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "author": "onup-1",
  "homepage": "https://github.com/onup-1/dsh-permission-plan#readme",
  "bugs": {
    "url": "https://github.com/onup-1/dsh-permission-plan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onup-1/dsh-permission-plan.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permission",
    "approval",
    "sandbox",
    "permissions"
  ],
  "engines": {
    "node": ">=20"
  }
}
