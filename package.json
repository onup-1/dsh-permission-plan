{
  "name": "dsh-permission-plan",
  "version": "0.1.0",
  "description": "One approval dialog for everything a task will need, then keyword memory instead of per-command prompts. Splits the batch pre-approval out of dsh-mod-build-auto-approve and merges it with generic keyword learning.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "permission",
    "approval",
    "sandbox"
  ]
}
